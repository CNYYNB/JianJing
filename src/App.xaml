<Application x:Class="XinCleaner.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <SolidColorBrush x:Key="Ink" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="Gray" Color="#5F6670"/>
    <SolidColorBrush x:Key="Line" Color="#E3E6EB"/>
    <SolidColorBrush x:Key="Accent" Color="#0F6CBD"/>

    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <!-- Fluent accent button -->
    <Style x:Key="PillButton" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#0F6CBD"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinWidth" Value="96"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="5"/>
              <Border x:Name="edge" CornerRadius="5" BorderThickness="0,0,0,1" BorderBrush="#0B5394" Opacity="0.7"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                    <Setter Property="Foreground" Value="White"/>
                  </Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1A76C6"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#0C5A9E"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Background" Value="#C5CAD1"/>
                <Setter TargetName="edge" Property="Opacity" Value="0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Fluent standard button -->
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="#1B1B1B"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinWidth" Value="72"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="#D6D9DE" BorderThickness="1" CornerRadius="5"/>
              <Border CornerRadius="5" BorderThickness="0,0,0,1" BorderBrush="#C2C6CC" Opacity="0.8"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#F6F7F9"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#EEF0F3"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#A0A5AD"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- text link button -->
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Foreground" Value="#0F6CBD"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="2">
              <ContentPresenter x:Name="c" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#0C5A9E"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- sidebar nav item: content is a horizontal panel (icon + text) -->
    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="#1B1B1B"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Border x:Name="b" Background="Transparent" CornerRadius="6"/>
              <Border x:Name="pill" Width="3" Height="16" CornerRadius="1.5" Background="#0F6CBD" HorizontalAlignment="Left" Visibility="Collapsed"/>
              <ContentPresenter Margin="14,0,8,0" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#0A000000"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="#0E000000"/>
                <Setter TargetName="pill" Property="Visibility" Value="Visible"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Fluent checkbox -->
    <Style x:Key="RoundCheck" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid Width="20" Height="20" VerticalAlignment="Center">
                <Border x:Name="box" CornerRadius="4" BorderBrush="#8A9099" BorderThickness="1" Background="White"/>
                <Path x:Name="tick" Data="M5,10.2 L8.4,13.4 L15,6.8" Stroke="White" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
              </Grid>
              <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                <Setter TargetName="box" Property="Background" Value="#0F6CBD"/>
                <Setter TargetName="box" Property="BorderBrush" Value="#0F6CBD"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="box" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Fluent toggle switch -->
    <Style x:Key="Toggle" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="40" Height="20" Background="Transparent">
              <Border x:Name="track" CornerRadius="10" BorderBrush="#8A8F98" BorderThickness="1" Background="White"/>
              <Ellipse x:Name="knob" Width="10" Height="10" Fill="#5F6670" HorizontalAlignment="Left" Margin="5,0,0,0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="#0F6CBD"/>
                <Setter TargetName="track" Property="BorderBrush" Value="#0F6CBD"/>
                <Setter TargetName="knob" Property="Fill" Value="White"/>
                <Setter TargetName="knob" Property="Width" Value="12"/>
                <Setter TargetName="knob" Property="Height" Value="12"/>
                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="knob" Property="Margin" Value="0,0,4,0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="track" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- segmented tab -->
    <Style x:Key="TabItem" TargetType="RadioButton">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="#5F6670"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,26,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <StackPanel Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" Margin="0,4,0,6"/>
              <Border x:Name="u" Height="3" Width="24" CornerRadius="1.5" Background="#0F6CBD" Visibility="Hidden"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="#1B1B1B"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter TargetName="u" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="FontSize" Value="13.5"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    </Style>
  </Application.Resources>
</Application>
